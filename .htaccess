Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|log|env|ini|bak|dist|md)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "\.(sql|log|env|ini|bak|dist|md)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(logs|tests|docs)/ - [F,L]
</IfModule>

